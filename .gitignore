*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode build output
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Xcode app packaging
*.app
*.xcarchive

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# CocoaPods / Carthage (not used, ignored defensively)
Pods/
Carthage/Build/

# Local environment / secrets
.env
.env.*
*.pem
*.key
